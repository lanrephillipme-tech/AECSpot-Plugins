<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="clr-namespace:AECSpot"
>
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary  Source="pack://application:,,,/AECSpot;component/Dictionaries/Fonts.xaml"></ResourceDictionary>
        <ResourceDictionary  Source="pack://application:,,,/AECSpot;component/Dictionaries/Colors.xaml"></ResourceDictionary>
        <ResourceDictionary  Source="pack://application:,,,/AECSpot;component/Dictionaries/CheckBox.xaml"></ResourceDictionary>
        <ResourceDictionary  Source="pack://application:,,,/AECSpot;component/Dictionaries/Buttons.xaml"></ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>
 
    <Style TargetType="TreeView">
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <HierarchicalDataTemplate  ItemsSource="{Binding Children}">
                    <Border x:Name="treeviewBorder" Visibility="{Binding Visibility}" >


                        <StackPanel  Visibility="{Binding Visibility}"
                            Orientation="Horizontal"
                                    Margin="5">
                            <CheckBox  Visibility="{Binding Visibility}"
                                Focusable="False"
                                      Cursor="Hand"
                                      Style="{StaticResource MainCheckBoxThreeStates}"
                                      IsChecked="{Binding IsChecked,Mode=TwoWay}"
                                      Content="{Binding Name}"
                                      x:Name="treeCheckBox"
                                     
                                 >

                               
                            </CheckBox>


                            <!--<TextBlock Text="{Binding Name}"
                                       Foreground="{StaticResource MainDarkGrey}"
                                       Margin="5,0" />-->
                        </StackPanel>
                    </Border>
                  
                </HierarchicalDataTemplate>
                
            </Setter.Value>
        </Setter>
       
    </Style>
    
    
