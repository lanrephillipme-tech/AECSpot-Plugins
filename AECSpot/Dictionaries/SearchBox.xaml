<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tk="http://schemas.xceed.com/wpf/xaml/toolkit"
>

    <!-- Style for the WatermarkTextBox with BorderThickness change on MouseOver -->
    <Style TargetType="tk:WatermarkTextBox"
           x:Key="SearchBoxStyle">
        <!-- Default Setter Properties -->
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="FontSize" Value="10.5" />

        <!-- Trigger to change BorderThickness when Mouse is Over -->
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderThickness" Value="1" />
                <!--<Setter Property="BorderBrush" Value="#E0E0E0" />-->
                <Setter Property="BorderBrush" Value="Yellow" />
                <Setter Property="FontSize" Value="10.5" />
              

                <!-- Optional: Change border color too -->
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>

