<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--#region Colors -->
    <Color x:Key="BureWhiteColor">#FFFFFF</Color>
    <Color x:Key="MainWhiteColor">#F8F8F8</Color>
    <Color x:Key="MainSoftLightGreyColor">#F9F9F9</Color>
    <Color x:Key="MainLightGreyColor">#CCCCCC</Color>
    <Color x:Key="MainBlueGreyColor">#D4E0E6</Color>
    <Color x:Key="MainDarkGreyColor">#7A7676</Color>
    <Color x:Key="MainSemiDarkGreyColor">#E0E0E0</Color>
    <Color x:Key="MainRedColor">#E60000</Color>
    <Color x:Key="MouseOverLightRedColor">#FF0C0C</Color>
    <Color x:Key="MainGreenColor">#58E5A8</Color>
    <Color x:Key="MouseOverLightBlueColor">#E5A063</Color>
    <Color x:Key="MainBlueColor">#E5A063</Color>
    <!--#endregion-->
    <!--#region Main Colors Brushes -->
    <SolidColorBrush Color="{StaticResource MainBlueColor}"
                     x:Key="MainBlue"></SolidColorBrush>
    <SolidColorBrush Color="{StaticResource MainGreenColor}"
                     x:Key="MainGreen"></SolidColorBrush>
    <SolidColorBrush Color="{StaticResource MainLightGreyColor}"
                     x:Key="MainLightGrey"></SolidColorBrush>
    <SolidColorBrush Color="{StaticResource MainSoftLightGreyColor}"
                     x:Key="MainSoftLightGrey"></SolidColorBrush>
    <SolidColorBrush Color="{StaticResource BureWhiteColor}"
                     x:Key="BureWhite"></SolidColorBrush>
    <SolidColorBrush Color="{StaticResource MainDarkGreyColor}"
                     x:Key="MainDarkGrey"></SolidColorBrush>
    <SolidColorBrush Color="{StaticResource MainSemiDarkGreyColor}"
                     x:Key="MainSemiDarkGrey"></SolidColorBrush>
    <SolidColorBrush Color="{StaticResource MainRedColor}"
                     x:Key="MainRed"></SolidColorBrush>
    <SolidColorBrush Color="{StaticResource MouseOverLightRedColor}"
                     x:Key="MouseOverLightRed"></SolidColorBrush>
    <SolidColorBrush Color="{StaticResource MainBlueGreyColor}"
                     x:Key="BlueGrey"></SolidColorBrush>
    <SolidColorBrush Color="{StaticResource MainWhiteColor}"
                     x:Key="MainWhite"></SolidColorBrush>
    <!--#endregion-->
    <!--#region Triggers Colors Brushes -->
    <SolidColorBrush Color="{StaticResource MouseOverLightBlueColor}"
                     x:Key="MouseOverLightBlue"></SolidColorBrush>
    <!--#endregion-->
</ResourceDictionary>