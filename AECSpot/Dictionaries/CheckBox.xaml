<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary  Source="pack://application:,,,/AECSpot;component/Dictionaries/Fonts.xaml"></ResourceDictionary>
        <ResourceDictionary  Source="pack://application:,,,/AECSpot;component/Dictionaries/Colors.xaml"></ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>
    <Style TargetType="CheckBox"
           x:Key="MainCheckBox">
        <Setter Property="BorderThickness"
                Value="1"></Setter>
        <Setter Property="BorderBrush"
                Value="{StaticResource MainLightGrey}"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0" >
                        <Image x:Name="checkboxImage"
                               Source="..\Resources\Images\CheckBox\UnCheckd.png"
                               Width="15" Margin="0 0 10 0"/>
                        <Border x:Name="contentBorder" Background="Transparent" Padding="0">
                            <ContentPresenter />
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="checkboxImage"
                                    Property="Source"
                                    Value="..\Resources\Images\CheckBox\check.png" />
                        </Trigger>
                        <Trigger Property="IsChecked"
                                 Value="False">
                            <Setter TargetName="checkboxImage"
                                    Property="Source"
                                    Value="..\Resources\Images\CheckBox\UnCheckd.png" />
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter Property="Background"
                                    Value="#E0E0E0"></Setter>

                        </Trigger>
                       
                        <MultiTrigger>
                            <!--<MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver"
                                           Value="True" />
                                <Condition Property="IsChecked"
                                           Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="checkboxImage"
                                    Property="Source"
                                    Value="pack://application:,,,/AECSpot;component/2.png" />-->
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox"
           x:Key="MainCheckBoxThreeStates">
        <Setter Property="BorderThickness"
                Value="1"></Setter>
        <Setter Property="BorderBrush"
                Value="{StaticResource MainLightGrey}"></Setter>
        <Setter Property="IsThreeState"
                Value="True"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <Image x:Name="checkboxImage"
                               Source="..\Resources\Images\CheckBox\UnCheckd.png"
                               Width="15" Margin="2 0 10 0" />
                        <Border x:Name="contentBorder" Background="Transparent" Padding="0">
                            <ContentPresenter />
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="checkboxImage"
                                    Property="Source"
                                    Value="..\Resources\Images\CheckBox\check.png" />
                        </Trigger>
                        <Trigger Property="IsChecked"
                                 Value="{x:Null}">
                            <Setter TargetName="checkboxImage"
                                    Property="Source"
                                    Value="..\Resources\Images\CheckBox\middleCaseCheck.png" />
                        </Trigger>
                        <Trigger Property="IsChecked"
                                 Value="False">
                            <Setter TargetName="checkboxImage"
                                    Property="Source"
                                    Value="..\Resources\Images\CheckBox\UnCheckd.png" />
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter Property="Background"
                                    Value="#E0E0E0"></Setter>

                        </Trigger>
                        <!--<Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="contentBorder" Property="Background" Value="#E0E0E0" />
                        </Trigger>-->
                        <MultiTrigger>
                            <!--<MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver"
                                           Value="True" />
                                <Condition Property="IsChecked"
                                           Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="checkboxImage"
                                    Property="Source"
                                    Value="pack://application:,,,/AECSpot;component/2.png" />-->
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                                 Value="True">

                <Setter Property="Background"
                                    Value="#E0E0E0"></Setter>

            </Trigger>
        </Style.Triggers>
    </Style>


</ResourceDictionary>