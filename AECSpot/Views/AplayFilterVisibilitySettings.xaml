                                 Maximum="100"
                                 Grid.Column="1"
                                 Width="300"
                                 x:Name="transparencyBar"
                                 Minimum="0"
                                         HorizontalAlignment="Right"
                                 Value="{Binding TransparencyValue}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
