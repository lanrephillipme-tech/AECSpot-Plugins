<Window x:Class="AECSpot.PurgeFiltersWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AEC Spot - Purge Filters" Width="900" Height="600" MinWidth="720" MinHeight="500" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#F7F7F7">
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="5" /></WindowChrome.WindowChrome>
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="pack://application:,,,/AECSpot;component/Dictionaries/ApplicationDictionary.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid><Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /><RowDefinition Height="58" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource MainBlue}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid Margin="14,0,8,0"><TextBlock Text="Purge Unused Filters" Foreground="White" FontSize="15" VerticalAlignment="Center" /><Button HorizontalAlignment="Right" Style="{StaticResource TextButton}" Content="Close" Foreground="White" Click="CloseButton_Click" /></Grid></Border>
        <Grid Grid.Row="1" Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="{StaticResource MainLightGrey}" BorderThickness="1" CornerRadius="4" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="Unused filters" FontWeight="SemiBold" Foreground="{StaticResource MainDarkGrey}" Margin="4" /><ListBox Grid.Row="1" ItemsSource="{Binding Candidates}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected}" Margin="4"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding CategoriesSummary}" Foreground="{StaticResource MainDarkGrey}" FontSize="11" TextWrapping="Wrap" /></StackPanel></CheckBox></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Grid.Row="1" Text="No unused parameter filters were found." Foreground="{StaticResource MainDarkGrey}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasCandidates}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border>
            <Border Grid.Column="2" BorderBrush="{StaticResource MainLightGrey}" BorderThickness="1" CornerRadius="4" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="Only filters with no direct project-view or view-template assignments are listed. Deletion cannot be undone except through Revit Undo." TextWrapping="Wrap" Foreground="{StaticResource MainDarkGrey}" /><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,8"><Button Content="Preview Deletion" Style="{StaticResource BlueButtonStyle}" Click="Preview_Click" /><TextBlock Text="{Binding Status}" Foreground="{StaticResource MainDarkGrey}" VerticalAlignment="Center" TextWrapping="Wrap" /></StackPanel><ListBox Grid.Row="2" ItemsSource="{Binding PreviewItems}" DisplayMemberPath="Name" BorderBrush="{StaticResource MainLightGrey}" BorderThickness="1" /><CheckBox Grid.Row="3" IsChecked="{Binding Confirmed}" Content="I understand that the selected unused filters will be permanently deleted." Margin="0,12,0,0" /></Grid></Border>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource MainSoftLightGrey}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Style="{StaticResource TextButton}" Margin="0,8" Click="CloseButton_Click" /><Button Content="Purge Filters" Style="{StaticResource BlueButtonStyle}" Margin="0,8,16,8" Click="Purge_Click" /></StackPanel></Border>
    </Grid>
</Window>

