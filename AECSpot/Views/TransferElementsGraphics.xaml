<Window x:Class="AECSpot.TransferElementsGraphics"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:AECSpot"
        xmlns:xctk1="http://schemas.xceed.com/wpf/xaml/toolkit"
        
        mc:Ignorable="d"
         Height="750"
   MinHeight="400"
   Width="1000"
   MinWidth="600"
   Background="#F7F7F7"
   WindowStyle="None"
   ResizeMode="CanResize"
      
        >

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"></WindowChrome>
    </WindowChrome.WindowChrome>
    <Window.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary  Source="pack://application:,,,/AECSpot;component/Dictionaries/ApplicationDictionary.xaml"></ResourceDictionary>

            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>


    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions >
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="80"></RowDefinition>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Background=" #E3E3E3"   Height="40" VerticalAlignment="Center" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="10 0 0 0" Grid.Column="0" Orientation="Horizontal">
                    <Image Width="20" Height="20" Source="/AECSpot;component/Resources/AEC Spot Logo 3.png" />


                    <TextBlock Text="AEC Spot - Manage Element Overrides" 
                          Foreground="Black" VerticalAlignment="Center" Margin="10,0,0,0"  FontSize="15"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
           Orientation="Horizontal" 
                   HorizontalAlignment="Right" >


                    <!-- Minimize Button -->
                    <Button 
                   
                   Style="{StaticResource TitlebarButton}"
                   Click="MinimizeButton_Click"
                   Tag="/AECSpot;component/Resources/Images/minimize.png"
                   >
                        <!--<Image Source="/AECSpot;component/Resources/Images/minimize.png" />-->




                    </Button>

                    <!-- Maximize Button -->
                    <Button Margin="20 0 20 0" 
                       Style="{StaticResource TitlebarButton}"
                       Click="MaximizeButton_Click"
                      Tag="/AECSpot;component/Resources/Images/Vector (2).png"

                       >

                        <!--<Image  Source="/AECSpot;component/Resources/Images/Vector (2).png" />-->

                    </Button>

                    <!-- Close Button -->
                    <Button   Style="{StaticResource TitlebarButton}"
                        Click="CloseButton_Click"
                         Margin="0 0 30 0"
                        Tag="/AECSpot;component/Resources/Images/Vector (1).png"
                           
                      >
                        <!--<Image  Source="/AECSpot;component/Resources/Images/Vector (1).png" />-->

                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="350*" />
            </Grid.ColumnDefinitions>





            <Border Grid.Column="0" Background="White" BorderThickness="0.5" BorderBrush="Gray">

                <StackPanel Margin="15" Orientation="Vertical">

                    <!-- Header -->
                    <DockPanel Margin="0,0,0,15">
                        <TextBlock Text="Presets"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>

                        <Button Content="+  New Preset"
                        Width="120"
                        Height="35"
                         Style="{StaticResource BlueButtonStyle}"
                       
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right"
                       Click="New_Preset_Clicked"
                        FontWeight="SemiBold"
                        Cursor="Hand">

                        </Button>
                    </DockPanel>

                    <!-- Search Box -->
                    <Grid VerticalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <xctk1:WatermarkTextBox x:Name="watermarkTextBox" 
                             Style="{StaticResource ResourceKey=SearchBoxStyle}"
             Watermark="Search Presets"
             Grid.Row="1"
             Grid.ColumnSpan="2"
             Margin="0 0 0 0"
             Height="25"
             BorderThickness="1"
   
             VerticalAlignment="Stretch"
             Text="{Binding searchWord}"
             TextChanged="WatermarkTextBox_TextChanged" SelectionBrush="#FFBC7B18" Background="White" BorderBrush="{DynamicResource MainLightGrey}"/>
                        <Image Height="16" Margin="0 0 5 0"  Grid.Column="1"
          HorizontalAlignment="Right" Source="/AECSpot;component/Resources/Images/mag.png" />
                    </Grid>
                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" HorizontalAlignment="Left" >
                        <Button Content="🗑 Delete"
                                    x:Name="DeleteButton"
                       Margin="0 0 10 0"
                        Background="#EEEEEE"
                        BorderBrush="#DDDDDD"
                         Style="{StaticResource BaleButtonStyle}"
                                    Click="DeleteButtonClick"
                                    />

                        <Button Content="⟳ Override"
                                    Style="{StaticResource BaleButtonStyle}"
                        x:Name="OverrideButton"
                        Background="#EEEEEE"
                        BorderBrush="#DDDDDD"
                                    Click="OverrideButtonClick"/>

                        <Button Content="⧉ Duplicate"
                                 Style="{StaticResource BaleButtonStyle}"   
                                    x:Name="DuplicateButton"
                        Click="DuplicateButton_Click"
                        Background="#EEEEEE"
                        BorderBrush="#DDDDDD"/>
                        <Button Content="⟳ Rename"
            Style="{StaticResource BaleButtonStyle}"
x:Name="RenameButton"
Background="#EEEEEE"
BorderBrush="#DDDDDD"
            Click="RenamePreset_Click"/>
                    </StackPanel>

                    <!-- Preset List -->
                    <Border BorderBrush="#DDD" BorderThickness="1">
                        <ListBox Height="400"
                                     DisplayMemberPath="Name"
                         Background="White"
                                     SelectionMode="Single"
                         BorderThickness="0"
                                     x:Name="ListOfOverrideElement"
                                     ItemsSource="{Binding OverrideElementModels}"
                                     SelectedItem="{Binding SelectedOverrideElementModels}"
                                     SelectionChanged="ListBox_SelectionChanged"
                                     >



                        </ListBox>
                    </Border>

                </StackPanel>

            </Border>

            <Border Grid.Column="2" Background="White" BorderThickness="0.5" BorderBrush="Gray">

                <Grid Margin="10 10 10 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="80" />
                    </Grid.RowDefinitions>
                    <ScrollViewer  VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                        
                    <StackPanel >


                        <CheckBox IsChecked="{Binding Halftone}"
                              x:Name="halftonecheckbox"
                                      Style="{StaticResource MainCheckBox}" 
                              VerticalAlignment="Center"
                          
                          Margin="15 15 0 0"
                        >Halftone</CheckBox>

                        <!-- Projection Lines -->
                        <Expander Style="{StaticResource CleanExpanderStyle}"
              IsExpanded="False"
              Expanded="Expander_Expanded"
              x:Name="Expamder_001"
              Margin="15,15,15,0">
                            <Expander.Header>
                                <TextBlock Text="Projection Lines" FontSize="14" Foreground="#333333"/>
                            </Expander.Header>
                            <StackPanel Margin="10,5,10,10">
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Line Pattern"
                           VerticalAlignment="Center"
                           FontSize="13" />
                                    <ComboBox Grid.Column="1"
                          Height="32"
                           Style="{StaticResource CustomComboBoxStyle}"
                          SelectedItem="{Binding Lines_SelectedLinePattern}"
                          SelectedIndex="0"
                          x:Name="Lines_Pattern" />
                                </Grid>

                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Color"
                           VerticalAlignment="Center"
                           FontSize="13" />
                                    <xctk1:ColorPicker Name="linePatternColor"
                                            Style="{StaticResource CustomComboBoxStyleColorPicker}"
                                                       
                                   Grid.Column="1"
                                   Height="32"
                                   BorderThickness="1"
                                   DisplayColorAndName="True"
                                   SelectedColorChanged="Lines_SelectedColorChanged"
                                   AvailableColorsSortingMode="HueSaturationBrightness"/>
                                </Grid>

                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Line Weight"
                           VerticalAlignment="Center"
                           FontSize="13" />
                                    <ComboBox Grid.Column="1"
                                              Style="{StaticResource CustomComboBoxStyle}"
                          Height="32"
                          SelectedItem="{Binding Lines_SelectedLineWeight}"
                          SelectedIndex="0"
                          x:Name="Lines_LineWieght" />
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- Projection Patterns -->
                        <Expander Style="{StaticResource CleanExpanderStyle}"
              IsExpanded="False"
              Expanded="Expander_Expanded"
              x:Name="Expamder_002"
              Margin="15,8,15,0">
                            <Expander.Header>
                                <TextBlock Text="Projection Patterns" FontSize="14" Foreground="#333333"/>
                            </Expander.Header>
                            <StackPanel Margin="10,5,10,10">
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Foreground Pattern"
                           VerticalAlignment="Center"
                           FontSize="13" />
                                    <CheckBox Grid.Column="1"
                          IsThreeState="True"
                          Style="{StaticResource MainCheckBox}" 
                          IsChecked="{Binding ForegroundPatternVisible}"
                          Content="Is Visible"
                          VerticalAlignment="Center"
                          x:Name="ForegroundVisible" />
                                </Grid>

                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Foreground Line Pattern"
                           VerticalAlignment="Center"
                           FontSize="13"
                           TextWrapping="Wrap" />
                                    <ComboBox Grid.Column="1"
                                              Style="{StaticResource CustomComboBoxStyle}"
                          SelectedItem="{Binding Pattern_Foreground_SelectedLinePattern}"
                          Height="32"
                          SelectedIndex="0"
                          x:Name="Pattern_ForeGround_Pattern" />
                                </Grid>

                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Foreground Color"
                           VerticalAlignment="Center"
                           FontSize="13" />
                                    <xctk1:ColorPicker Name="PatterForegroundColor"
                                                                                                   Style="{StaticResource CustomComboBoxStyleColorPicker}"

                                   Grid.Column="1"
                                   Height="32"
                                   BorderThickness="1"
                                   DisplayColorAndName="True"
                                   SelectedColorChanged="Pattern_Foreground_SelectedColorChanged"
                                   AvailableColorsSortingMode="HueSaturationBrightness"/>
                                </Grid>

                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Background Pattern"
                           VerticalAlignment="Center"
                           FontSize="13" />
                                    <CheckBox Grid.Column="1"
                                               Style="{StaticResource MainCheckBox}" 
                          IsChecked="{Binding BackgroundPatternVisible}"
                          IsThreeState="True"
                          Content="Is Visible"
                          VerticalAlignment="Center"
                          x:Name="backgroundVisible" />
                                </Grid>

                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Background Line Pattern"
                           VerticalAlignment="Center"
                           FontSize="13"
                           TextWrapping="Wrap" />
                                    <ComboBox Grid.Column="1"
                                              Style="{StaticResource CustomComboBoxStyle}"
                          Height="32"
                          SelectedItem="{Binding Pattern_Background_SelectedLinePattern}"
                          SelectedIndex="0"
                          x:Name="Pattern_Background_Pattern" />
                                </Grid>

                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Background Color"
                           VerticalAlignment="Center"
                           FontSize="13" />
                                    <xctk1:ColorPicker Name="PatterBackgroundColor"
                                                                                                   Style="{StaticResource CustomComboBoxStyleColorPicker}"

                                   Grid.Column="1"
                                   Height="32"
                                   BorderThickness="1"
                                   DisplayColorAndName="True"
                                   SelectedColorChanged="Pattern_Background_SelectedColorChanged"
                                   AvailableColorsSortingMode="HueSaturationBrightness"/>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- Transparency -->
                        <Expander Style="{StaticResource CleanExpanderStyle}"
              IsExpanded="False"
              Expanded="Expander_Expanded"
              x:Name="Expamder_003"
              Margin="15,8,15,0">
                            <Expander.Header>
                                <TextBlock Text="Transparency" FontSize="14" Foreground="#333333"/>
                            </Expander.Header>
                            <StackPanel Margin="10,5,10,10">
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                           FontSize="13"
                           Text="{Binding ElementName=transparencyBar, Path=Value, StringFormat=0}" />
                                    <Slider Grid.Column="1"
                        Interval="10"
                        Maximum="100"
                        x:Name="transparencyBar"
                        Minimum="0"
                        VerticalAlignment="Center"
                        Value="{Binding TransparencyValue}" />
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- Cut Pattern -->
                        <Expander Style="{StaticResource CleanExpanderStyle}"
              IsExpanded="False"
              Expanded="Expander_Expanded"
              x:Name="Expamder_004"
              Margin="15,8,15,0">
                            <Expander.Header>
                                <TextBlock Text="Cut Patterns" FontSize="14" Foreground="#333333"/>
                            </Expander.Header>
                            <StackPanel Margin="10,5,10,10">
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Foreground Pattern"
                           VerticalAlignment="Center"
                           FontSize="13" />
                                    <CheckBox Grid.Column="1"
                                               Style="{StaticResource MainCheckBox}" 
                          IsChecked="{Binding CutForegroundPatternVisible}"
                          IsThreeState="True"
                          Content="Is Visible"
                          VerticalAlignment="Center"
                          x:Name="CutForegroundVisible" />
                                </Grid>

                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Foreground Line Pattern"
                           VerticalAlignment="Center"
                           FontSize="13"
                           TextWrapping="Wrap" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource CustomComboBoxStyle}"
                          SelectedItem="{Binding CutPattern_Foreground_SelectedLinePattern}"
                          Height="32"
                          SelectedIndex="0"
                          x:Name="CutPattern_ForeGround_Pattern" />
                                </Grid>

                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Foreground Color"
                           VerticalAlignment="Center"
                           FontSize="13" />
                                    <xctk1:ColorPicker Name="CutPatterForegroundColor"
                                                                                                   Style="{StaticResource CustomComboBoxStyleColorPicker}"

                                   Grid.Column="1"
                                   Height="32"
                                   BorderThickness="1"
                                   DisplayColorAndName="True"
                                   SelectedColorChanged="CutPatterForegroundColor_SelectedColorChanged"
                                   AvailableColorsSortingMode="HueSaturationBrightness"/>
                                </Grid>

                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Background Pattern"
                           VerticalAlignment="Center"
                           FontSize="13" />
                                    <CheckBox Grid.Column="1"  Style="{StaticResource MainCheckBox}" 
                          IsChecked="{Binding CutBackgroundPatternVisible}"
                          Content="Is Visible"
                          IsThreeState="True"
                          VerticalAlignment="Center"
                          x:Name="CutbackgroundVisible" />
                                </Grid>

                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Background Line Pattern"
                           VerticalAlignment="Center"
                           FontSize="13"
                           TextWrapping="Wrap" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource CustomComboBoxStyle}"
                          Height="32"
                          SelectedItem="{Binding CutPattern_Background_SelectedLinePattern}"
                          SelectedIndex="0"
                          x:Name="CutPattern_Background_Pattern" />
                                </Grid>

                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Background Color"
                           VerticalAlignment="Center"
                           FontSize="13" />
                                    <xctk1:ColorPicker Name="CutPatterBackgroundColor"                                     
                                                       Style="{StaticResource CustomComboBoxStyleColorPicker}"

                                   Grid.Column="1"
                                   Height="32"
                                   BorderThickness="1"
                                   DisplayColorAndName="True"
                                   SelectedColorChanged="CutPatterBackgroundColor_SelectedColorChanged"
                                   AvailableColorsSortingMode="HueSaturationBrightness"/>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- Cut Lines -->
                        <Expander Style="{StaticResource CleanExpanderStyle}"
              IsExpanded="False"
              Expanded="Expander_Expanded"
              x:Name="Expamder_005"
              Margin="15,8,15,0">
                            <Expander.Header>
                                <TextBlock Text="Cut Lines" FontSize="14" Foreground="#333333"/>
                            </Expander.Header>
                            <StackPanel Margin="10,5,10,10">
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Line Pattern"
                           VerticalAlignment="Center"
                           FontSize="13" />
                                    <ComboBox Grid.Column="1"
                                              Style="{StaticResource CustomComboBoxStyle}"
                          Height="32"
                          SelectedItem="{Binding CutLines_SelectedLinePattern}"
                          SelectedIndex="0"
                          x:Name="CutLines_Pattern" />
                                </Grid>

                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Color"
                           VerticalAlignment="Center"
                           FontSize="13" />
                                    <xctk1:ColorPicker Name="CutlinePatternColor"
                                                                                                   Style="{StaticResource CustomComboBoxStyleColorPicker}"

                                   Grid.Column="1"
                                   Height="32"
                                   BorderThickness="1"
                                   DisplayColorAndName="True"
                                   SelectedColorChanged="CutlinePatternColor_SelectedColorChanged"
                                   AvailableColorsSortingMode="HueSaturationBrightness"/>
                                </Grid>

                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Line Weight"
                           VerticalAlignment="Center"
                           FontSize="13" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource CustomComboBoxStyle}"
                          Height="32"
                          SelectedItem="{Binding CutLines_SelectedLineWeight}"
                          SelectedIndex="0"
                          x:Name="CutLines_LineWieght" />
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal"
                    Grid.Row="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                        <!--<Button x:Name="LoadPresetButton"
                    Content="Load Preset"
                    Height="35"
                    Background="#C2C2C2"
                    Width="120"
                    Click="LoadPresetButton_Click" />-->
                        <Button x:Name="ResetButton"
                     Content="Reset Override"
                     Grid.Column="1"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     Height="35"
                    
                     Width="120"
                     Click="ResetButton_Click" 
                                Style="{StaticResource LightButtonStyle}"
                                />

                        <!--<Button x:Name="CopyElementOverrids"
                    Content="Copy Overrides"
                    Height="40"
                    Width="120"
                    Click="CopyElementOverrids_Click" />-->
                        <Button x:Name="ApplyButton"
                    Content="✓ Apply"
                    Height="40"
                    Width="120"
                                Style="{StaticResource BlueButtonStyle}"
                    Click="ApplyButton_Click" />
                        <!--<Button x:Name="SavePresetButton"
                    Content="Save Preset"
                    Height="35"
                    Width="120"
                    Background="#C2C2C2"
                    Click="SavePreset_Click" />-->

                    </StackPanel>
                </Grid >

            </Border>


        </Grid>




        <!-- Contact Area -->

        <Border Background=" #E3E3E3" Grid.Row="2"  Height="80" VerticalAlignment="Center" HorizontalAlignment="Stretch" >

            <Grid 
             Margin="20 0 0 0" 
             HorizontalAlignment="Stretch"
             VerticalAlignment="Bottom" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"></ColumnDefinition>
                    <ColumnDefinition ></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <Image Width="45" Height="45" HorizontalAlignment="Left" Source="/AECSpot;component/Resources/AEC Spot Logo 2.png" />

                    <StackPanel Margin="0 0 0 8"  Orientation="Horizontal">


                        <!--<Button BorderThickness="0"  Height="25" Click="Button_Click" Background="Transparent">
                   <Button.Content>
                           <Border   VerticalAlignment="Center" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                       <StackPanel Orientation="Horizontal">

                               <TextBlock TextDecorations="Underline"  VerticalAlignment="Center"  Background="Transparent">
                                   aecspot.com</TextBlock>
                           <Image Source="/AECSpot;component/Resources/Images/square-arrow-up-right-02.png" />

                       </StackPanel>
                           </Border>
                   </Button.Content>

               
           </Button>-->
                        <Button Style="{StaticResource ContactrButton}" 
                       Click="Button_Click"
                       Margin="0 0 15 0">

                            aecspot.com



                        </Button>
                        <Button Margin="0 0 15 0" Style="{StaticResource ContactrButton}" Click="Button_Click_1">
                            Find Models
                        </Button>
                        <Button Style="{StaticResource ContactrButton}" Click="Button_Click_2">
                            more plugins
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!--<StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 50 0" >
                    <Button 
                   Click="CopyDataClicked"
                       CommandParameter="Slow"
                       Style="{StaticResource BlueButtonStyle}">Copy</Button>
                </StackPanel>-->
            </Grid>
        </Border>
    </Grid>

</Window>
