<Window x:Class="AECSpot.BulkRenameFiltersWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AEC Spot - Bulk Rename Filters" Width="980" Height="660" MinWidth="780" MinHeight="540" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#F7F7F7">
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="5" /></WindowChrome.WindowChrome>
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="pack://application:,,,/AECSpot;component/Dictionaries/ApplicationDictionary.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid><Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /><RowDefinition Height="58" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource MainBlue}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid Margin="14,0,8,0"><TextBlock Text="Bulk Rename Filters" Foreground="White" FontSize="15" VerticalAlignment="Center" /><Button HorizontalAlignment="Right" Style="{StaticResource TextButton}" Content="Close" Foreground="White" Click="CloseButton_Click" /></Grid></Border>
        <Grid Grid.Row="1" Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="{StaticResource MainLightGrey}" BorderThickness="1" CornerRadius="4" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="Select filters" FontWeight="SemiBold" Foreground="{StaticResource MainDarkGrey}" Margin="4" /><ListBox Grid.Row="1" ItemsSource="{Binding Filters}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected}" Margin="4"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding UsageSummary}" FontSize="11" Foreground="{StaticResource MainDarkGrey}" /></StackPanel></CheckBox></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Grid.Row="1" Text="No parameter filters found in this project." Foreground="{StaticResource MainDarkGrey}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasFilters}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border>
            <Border Grid.Column="2" BorderBrush="{StaticResource MainLightGrey}" BorderThickness="1" CornerRadius="4" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Find" FontWeight="SemiBold" /><TextBox Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}" Padding="5" /><TextBlock Text="Replace with" FontWeight="SemiBold" Margin="0,8,0,0" /><TextBox Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}" Padding="5" /></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Prefix" FontWeight="SemiBold" /><TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" Padding="5" /><TextBlock Text="Suffix" FontWeight="SemiBold" Margin="0,8,0,0" /><TextBox Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" Padding="5" /></StackPanel></Grid><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,8"><Button Content="Preview" Style="{StaticResource BlueButtonStyle}" Click="Preview_Click" /><TextBlock Text="{Binding Status}" Foreground="{StaticResource MainDarkGrey}" VerticalAlignment="Center" TextWrapping="Wrap" /></StackPanel><ListView Grid.Row="2" ItemsSource="{Binding PreviewItems}"><ListView.View><GridView><GridViewColumn Header="Current name" DisplayMemberBinding="{Binding Filter.Name}" Width="190" /><GridViewColumn Header="Proposed name" DisplayMemberBinding="{Binding ProposedName}" Width="190" /><GridViewColumn Header="Validation" DisplayMemberBinding="{Binding ValidationMessage}" Width="220" /></GridView></ListView.View></ListView></Grid></Border>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource MainSoftLightGrey}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Style="{StaticResource TextButton}" Margin="0,8" Click="CloseButton_Click" /><Button Content="Apply" Style="{StaticResource BlueButtonStyle}" Margin="0,8,16,8" Click="Apply_Click" /></StackPanel></Border>
    </Grid>
</Window>

