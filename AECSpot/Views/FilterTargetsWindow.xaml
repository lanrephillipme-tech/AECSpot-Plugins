<Window x:Class="AECSpot.FilterTargetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AEC Spot - Filter Targets" Width="980" Height="640" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#F7F7F7">
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="5" /></WindowChrome.WindowChrome>
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="pack://application:,,,/AECSpot;component/Dictionaries/ApplicationDictionary.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /><RowDefinition Height="58" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource MainBlue}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid Margin="14,0,8,0"><TextBlock Text="Filter Targets" Foreground="White" FontSize="15" VerticalAlignment="Center" /><Button HorizontalAlignment="Right" Style="{StaticResource TextButton}" Content="Close" Foreground="White" Click="CloseButton_Click" /></Grid></Border>
        <Grid Grid.Row="1" Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="{StaticResource MainLightGrey}" BorderThickness="1" CornerRadius="4" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="7" ToolTip="Search filter names or categories" /><ListBox Grid.Row="2" ItemsSource="{Binding FilterItems}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding UsageSummary}" Foreground="{StaticResource MainDarkGrey}" FontSize="11" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Grid.Row="2" Text="No parameter filters found in this project." Foreground="{StaticResource MainDarkGrey}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasFilters}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border>
            <Border Grid.Column="2" BorderBrush="{StaticResource MainLightGrey}" BorderThickness="1" CornerRadius="4" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel DataContext="{Binding SelectedFilter}">
                <TextBlock Text="Filter Targets" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource MainDarkGrey}" /><TextBlock Text="{Binding Name}" FontSize="22" Margin="0,6,0,4" TextWrapping="Wrap" /><TextBlock Text="{Binding CategoriesSummary}" Foreground="{StaticResource MainDarkGrey}" Margin="0,0,0,12" TextWrapping="Wrap" />
                <TextBlock Text="Used in Views" FontWeight="SemiBold" Foreground="{StaticResource MainDarkGrey}" /><ItemsControl ItemsSource="{Binding ViewUsages}" Margin="0,4,0,10"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding ViewName}" Margin="0,1" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="Used in View Templates" FontWeight="SemiBold" Foreground="{StaticResource MainDarkGrey}" /><ItemsControl ItemsSource="{Binding TemplateUsages}" Margin="0,4,0,14"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding ViewName}" Margin="0,1" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <Button Content="Find Matching Elements" Style="{StaticResource BlueButtonStyle}" HorizontalAlignment="Left" Click="FindMatchingElements_Click" /><TextBlock DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}" Text="{Binding QueryStatus}" Foreground="{StaticResource MainDarkGrey}" Margin="0,4,0,6" TextWrapping="Wrap" />
                <ItemsControl DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}" ItemsSource="{Binding MatchingElements}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource MainLightGrey}" BorderThickness="0,0,0,1" Padding="0,4"><TextBlock TextWrapping="Wrap"><Run Text="{Binding CategoryName}" /><Run Text=": " /><Run Text="{Binding Name}" /><Run Text=" (Id " /><Run Text="{Binding ElementId}" /><Run Text=")" /></TextBlock></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></ScrollViewer></Border>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource MainSoftLightGrey}"><Button Content="Close" Style="{StaticResource BlueButtonStyle}" HorizontalAlignment="Right" Margin="0,8,16,8" Click="CloseButton_Click" /></Border>
    </Grid>
</Window>

