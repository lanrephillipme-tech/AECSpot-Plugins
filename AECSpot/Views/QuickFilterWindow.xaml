<Window x:Class="AECSpot.QuickFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AEC Spot - Quick Filter" Width="1000" Height="690" MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#F7F7F7">
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="5" /></WindowChrome.WindowChrome>
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="pack://application:,,,/AECSpot;component/Dictionaries/ApplicationDictionary.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="78"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource MainBlue}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid Margin="14,0,8,0"><TextBlock Text="Quick Filter" Foreground="White" FontSize="15" VerticalAlignment="Center"/><Button HorizontalAlignment="Right" Style="{StaticResource TextButton}" Content="Close" Foreground="White" Click="CloseButton_Click"/></Grid></Border>
        <Grid Grid.Row="1" Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="{StaticResource MainLightGrey}" BorderThickness="1" CornerRadius="4" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Categories" FontWeight="SemiBold" Foreground="{StaticResource MainDarkGrey}"/><ListBox Grid.Row="1" ItemsSource="{Binding Categories}" BorderThickness="0" Margin="0,6"><ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="2"/></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="2" Content="Load Common Parameters" Style="{StaticResource BlueButtonStyle}" Click="LoadParameters_Click"/></Grid></Border>
            <Border Grid.Column="2" BorderBrush="{StaticResource MainLightGrey}" BorderThickness="1" CornerRadius="4" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Rules (all rules must match)" FontWeight="SemiBold" Foreground="{StaticResource MainDarkGrey}"/><Button Grid.Row="1" Content="Add Rule" Style="{StaticResource BlueButtonStyle}" HorizontalAlignment="Left" Margin="0,7,0,0" Click="AddRule_Click"/>
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Rules}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding DataContext.Parameters, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Parameter}" DisplayMemberPath="DisplayName" Margin="0,0,5,0"/><ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.Operators, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Operator}" Margin="0,0,5,0"/><TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,5,0"/><Button Grid.Column="3" Content="Remove" Style="{StaticResource TextButton}" Click="RemoveRule_Click" Tag="{Binding}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                <StackPanel Grid.Row="4"><TextBlock Text="Save name (only for Save to Project)" Foreground="{StaticResource MainDarkGrey}" Margin="0,8,0,2"/><TextBox Text="{Binding SaveName, UpdateSourceTrigger=PropertyChanged}" Padding="6"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource MainDarkGrey}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
            </Grid></Border>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource MainSoftLightGrey}"><WrapPanel HorizontalAlignment="Right" Margin="8"><Button Content="Select Current View" Style="{StaticResource BlueButtonStyle}" Margin="3" Click="SelectCurrentView_Click"/><Button Content="Select Entire Project" Style="{StaticResource BlueButtonStyle}" Margin="3" Click="SelectEntireProject_Click"/><Button Content="Override in View" Style="{StaticResource BlueButtonStyle}" Margin="3" Click="TemporaryOverride_Click"/><Button Content="Isolate in View" Style="{StaticResource BlueButtonStyle}" Margin="3" Click="TemporaryIsolate_Click"/><Button Content="Reset Overrides" Style="{StaticResource BlueButtonStyle}" Margin="3" Click="ResetOverrides_Click"/><Button Content="Save to Project" Style="{StaticResource BlueButtonStyle}" Margin="3" Click="SaveToProject_Click"/><Button Content="Close" Style="{StaticResource BlueButtonStyle}" Margin="3" Click="CloseButton_Click"/></WrapPanel></Border>
    </Grid>
</Window>

