                                                                    Value="white" />
                                                    </Trigger>-->
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.Resources>
                </ListView>
            
               
        </Grid>
            </Border>
        <!-- Contact Area -->

        <Border Background=" #E3E3E3" Grid.Row="2"  Height="80" VerticalAlignment="Center" HorizontalAlignment="Stretch" >

            <Grid 
              Margin="20 0 0 0" 
              HorizontalAlignment="Stretch"
              VerticalAlignment="Bottom" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"></ColumnDefinition>
                    <ColumnDefinition Width="25*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <Image Width="45" Height="45" HorizontalAlignment="Left" Source="/AECSpot;component/Resources/AEC Spot Logo 2.png" />

                    <StackPanel Margin="0 0 0 8"  Orientation="Horizontal">


