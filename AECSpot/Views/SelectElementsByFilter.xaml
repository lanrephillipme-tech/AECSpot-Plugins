    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions >
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="80"></RowDefinition>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Background=" #E3E3E3"   Height="40" VerticalAlignment="Center" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="10 0 0 0" Grid.Column="0" Orientation="Horizontal">
                    <Image Width="20" Height="20" Source="/AECSpot;component/Resources/AEC Spot Logo 3.png" />


                    <TextBlock Text="AEC Spot - Select by Filter" 
                           Foreground="Black" VerticalAlignment="Center" Margin="10,0,0,0"  FontSize="15"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
            Orientation="Horizontal" 
                    HorizontalAlignment="Right" >


                    <!-- Minimize Button -->
                    <Button 
                    
                    Style="{StaticResource TitlebarButton}"
                    Click="MinimizeButton_Click"
                    Tag="/AECSpot;component/Resources/Images/minimize.png"
                    >
                        <!--<Image Source="/AECSpot;component/Resources/Images/minimize.png" />-->




                    </Button>

                    <!-- Maximize Button -->
                    <Button Margin="20 0 20 0" 
                        Style="{StaticResource TitlebarButton}"
                        Click="MaximizeButton_Click"
                       Tag="/AECSpot;component/Resources/Images/Vector (2).png"

                        >

                        <!--<Image  Source="/AECSpot;component/Resources/Images/Vector (2).png" />-->

                    </Button>

                    <!-- Close Button -->
                    <Button   Style="{StaticResource TitlebarButton}"
                         Click="CloseButton_Click"
                          Margin="0 0 30 0"
                         Tag="/AECSpot;component/Resources/Images/Vector (1).png"
                            
                       >
                        <!--<Image  Source="/AECSpot;component/Resources/Images/Vector (1).png" />-->

                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
