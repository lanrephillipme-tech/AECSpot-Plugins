                 SelectionChanged="ViewFiltersList_SelectionChanged"

                  SelectedItem="{Binding SelectedFilter}"
                  ItemsSource="{Binding DocumentsFilter}"
                  x:Name="FiltersList">
                    <ListView.Resources>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border Background="White"
                                        BorderBrush="#b3b3b3"
                                        Margin="2"
                                      
                                        Height="25"
                                        CornerRadius="3"
                                        Name="border">
                                            <CheckBox Content="{Binding Name}" 
                                                            IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, 
                                                                             Path=IsSelected,Mode=OneWay}"
                                                                      Height="25"
                                                                      HorizontalAlignment="Stretch"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalContentAlignment="Left"
                                                                      VerticalContentAlignment="Center"
                                                                   Style="{StaticResource MainCheckBox}"
                                                                      IsEnabled="False"
                                                                        Checked="textValue_Checked"
                                                                   x:Name="textValue"
                                                                   Foreground="#FF6B6B6B">

                                            </CheckBox>
                                        </Border>
                                        <!--<ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
