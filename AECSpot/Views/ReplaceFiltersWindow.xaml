<Window x:Class="AECSpot.ReplaceFiltersWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AEC Spot - Replace Filters" Width="860" Height="520" MinWidth="680" MinHeight="440" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#F7F7F7">
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="5" /></WindowChrome.WindowChrome>
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="pack://application:,,,/AECSpot;component/Dictionaries/ApplicationDictionary.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid><Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /><RowDefinition Height="58" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource MainBlue}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid Margin="14,0,8,0"><TextBlock Text="Replace Filters" Foreground="White" FontSize="15" VerticalAlignment="Center" /><Button HorizontalAlignment="Right" Style="{StaticResource TextButton}" Content="Close" Foreground="White" Click="CloseButton_Click" /></Grid></Border>
        <Border Grid.Row="1" Margin="16" BorderBrush="{StaticResource MainLightGrey}" BorderThickness="1" CornerRadius="4" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBlock Text="Replace direct filter assignments in project views and view templates. The source filter definition will remain in the project." TextWrapping="Wrap" Foreground="{StaticResource MainDarkGrey}" />
            <Grid Grid.Row="1" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="Source filter" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SourceFilter}" DisplayMemberPath="Name" Margin="0,5,0,0" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Replacement filter" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding ReplacementFilter}" DisplayMemberPath="Name" Margin="0,5,0,0" /></StackPanel></Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,8"><Button Content="Preview" Style="{StaticResource BlueButtonStyle}" Click="Preview_Click" /><TextBlock Text="{Binding Status}" Foreground="{StaticResource MainDarkGrey}" VerticalAlignment="Center" TextWrapping="Wrap" /></StackPanel>
            <StackPanel Grid.Row="3"><TextBlock Text="Preview details" FontWeight="SemiBold" Foreground="{StaticResource MainDarkGrey}" /><TextBlock Text="{Binding PlannedAssignmentCount, StringFormat=Assignments to replace: {0}}" Margin="0,4,0,0" /><TextBlock Text="{Binding ExistingReplacementCount, StringFormat=Destinations already using replacement: {0}}" /><TextBlock Text="When both filters are assigned, the source visibility, enabled state, and graphics overrides take precedence. Revit 2024 does not expose a reliable filter-reorder setter: an existing replacement retains its order; a newly added replacement is appended by Revit." Foreground="{StaticResource MainDarkGrey}" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel>
        </Grid></Border>
        <Border Grid.Row="2" Background="{StaticResource MainSoftLightGrey}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Style="{StaticResource TextButton}" Margin="0,8" Click="CloseButton_Click" /><Button Content="Apply" Style="{StaticResource BlueButtonStyle}" Margin="0,8,16,8" Click="Apply_Click" /></StackPanel></Border>
    </Grid>
</Window>

